# Copy to .env.local for development. In production, set these in Vercel.

# Shared passcode for the 4 of us (anything memorable, 8+ characters).
TEAM_PASSCODE=
# Separate passcode for parents/guardians. Unlocks only /parent.
PARENT_PASSCODE=
# Long random string used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Random string in the subscribable calendar URL (/api/calendar/<token>).
CALENDAR_TOKEN=

# Private GitHub repo that stores receipts, tickets and reports (documents/ folder).
# Fine-grained token: this repo only, Contents read and write. Never commit it:
# put it in .env.local on your laptop and in Vercel's Environment Variables.
GITHUB_RECEIPTS_TOKEN=
# owner/repo
GITHUB_RECEIPTS_REPO=omsenjalia/guwahati-run

# Optional: the Chat tab's AI. Free key from https://console.Groq.com.
# Server-side only, never in the app. Without it, /api/chat still answers
# common questions straight from the collected trip data.
GROQ_API_KEY=
# Optional: Groq model id your key can use (default openai/gpt-oss-120b,
# same as WeatherGPT; llama-3.3-70b-versatile is a faster alternative).
GROQ_MODEL=openai/gpt-oss-120b
